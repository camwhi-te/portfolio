---
import { sections } from "../lib/nav.ts";
import { site } from "../site.ts";

/**
 * The running head: the name (always the way home), the site's sections, and
 * the sheet counter. It stays at the top of the window at every width; on a
 * phone the sections fold behind a Menu button.
 */
interface Props {
  /** Numeral of the page or section being read, for aria-current. */
  current?: number | undefined;
  sheets: number;
}

const { current, sheets } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<header class="running-head" data-running-head>
  <div class="running-head__inner">
    <a class="running-head__home" href="/" aria-current={isHome ? "page" : undefined}>
      {site.name}<span class="visually-hidden">, front page</span>
    </a>
    <button class="running-head__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      Menu
    </button>
    <nav class="running-head__nav" id="site-nav" aria-label="Main">
      <ol>
        {
          sections.map((item) => (
            <li>
              <a href={item.href} data-ref={String(item.n)} aria-current={current === item.n ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="running-head__sheet" aria-live="off">
      Sheet <output data-sheet-current>1</output> of <span data-sheet-total>{sheets}</span>
    </p>
  </div>
</header>
