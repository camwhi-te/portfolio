---
/**
 * Shared pattern definitions for every drawing on the page: the 45-degree
 * hatching that shades side faces, and the blue-pencil hatching that marks a
 * lit part. Rendered once, near the top of <body>.
 */
---

<svg class="ink-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="hatch" width="4.5" height="4.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="4.5" stroke="#191e2e" stroke-width="0.75"></line>
    </pattern>
    <pattern id="hatch-lit" width="3.5" height="3.5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="3.5" stroke="#2c6a87" stroke-width="0.85"></line>
    </pattern>
  </defs>
</svg>

<style>
  .ink-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }
</style>
