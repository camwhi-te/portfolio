  { kind: "box", ref: "106", x: 40, y: 616, w: 230, h: 50, label: "NODE DAEMON", sub: "Wings API", layer: 1 },
  { kind: "box", ref: "108", numeral: "108a", x: 58, y: 676, w: 212, h: 22, label: "CONTAINER", layer: 1 },
  { kind: "box", ref: "108", numeral: "108b", x: 58, y: 702, w: 212, h: 22, label: "CONTAINER", layer: 1 },
  { kind: "box", ref: "108", numeral: "108c", x: 58, y: 728, w: 212, h: 22, label: "CONTAINER", layer: 1 },
  {
    kind: "wire",
    d: "M130 120 V214",
    heads: [
      [130, 120, -90],
      [130, 214, 90],
    ],
    label: { x: 138, y: 168, text: "HTTPS", anchor: "start" },
  },
  {
    kind: "wire",
    d: "M318 120 V376 H272",
    heads: [
      [318, 120, -90],
      [272, 376, 180],
    ],
    label: { x: 330, y: 250, text: "PAYMENT API", rotate: 90 },
  },
  {
    kind: "wire",
    d: "M34 80 H12 V641 H38",
    heads: [
      [34, 80, 0],
      [38, 641, 0],
    ],
    label: { x: 7, y: 470, text: "WEBSOCKET CONSOLE", rotate: -90 },
  },
  {
    kind: "wire",
    d: "M264 428 V614",
    heads: [
      [264, 428, -90],
      [264, 614, 90],
    ],
    label: { x: 256, y: 574, text: "DAEMON API", anchor: "end" },
  },
  { kind: "wire", d: "M86 426 V465" },
  { kind: "wire", d: "M206 426 V465" },
  { kind: "wire", d: "M48 666 V739 M48 687 H58 M48 713 H58 M48 739 H58" },
  { kind: "leader", ref: "130", at: [160, 46], from: [158, 49], to: [146, 57] },
  { kind: "leader", ref: "102", at: [352, 178], from: [326, 180], to: [296, 194], anchor: "end" },
  { kind: "leader", ref: "120", at: [352, 578], from: [326, 580], to: [296, 594], anchor: "end" },
  { kind: "text", x: 86, y: 548, text: "MySQL · MariaDB", anchor: "middle" },
  { kind: "text", x: 206, y: 548, text: "Redis", anchor: "middle" },
];

const title = `Figure ${fig}: block diagram of a Jexpanel deployment`;
const description =
  "A user's browser 130 reaches the panel 102 over HTTPS. The panel holds the web interface 112, the application and API 114 and billing 104, which talks to payment providers 140. The panel keeps its data in a database 110 and a cache and queue 116, and drives the daemon 106 on each node 120 through the daemon API. The daemon runs game servers in containers 108a to 108c, and the browser opens each server's console directly to the daemon over a WebSocket.";
---

<Plate
  fig={fig}
  caption="Block diagram of a Jexpanel deployment"
  signs={jexpanelSigns}
  sheet={sheet}
  transition="fig-jexpanel"
>
  <Diagram
    class="plate__drawing--wide"
    width={760}
    height={430}
    elements={wide}
    title={title}
    description={description}
    first={first}
  />
  <Diagram
    class="plate__drawing--tall"
    width={360}
    height={772}
    elements={tall}
    title={title}
    description={description}
    first={first}
  />
</Plate>
