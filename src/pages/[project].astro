---
import type { GetStaticPaths } from "astro";
import Blank from "../components/Blank.astro";
import Field from "../components/Field.astro";
import Fill from "../components/Fill.astro";
import FalconServices from "../components/figures/FalconServices.astro";
import JexpanelDeployment from "../components/figures/JexpanelDeployment.astro";
import ReleaseActivity from "../components/figures/ReleaseActivity.astro";
import RepositoryPlate from "../components/figures/RepositoryPlate.astro";
import TelcodashStack from "../components/figures/TelcodashStack.astro";
import Live from "../components/Live.astro";
import Document from "../layouts/Document.astro";
import { commitsInLastYear, getProjects, getRepo, releaseFacts } from "../lib/content.ts";
import { falconSigns, jexpanelSigns, telcodashSigns, type Sign } from "../lib/figures.ts";
import { formatDate, formatNumber, languageShares, percent } from "../lib/format.ts";
import type { RepoEntry } from "../lib/github/schema.ts";
import { section } from "../lib/nav.ts";
import { hasText, linkNumerals } from "../lib/refs.ts";
import { site } from "../site.ts";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { project: project.id } }));
}) satisfies GetStaticPaths;

const projects = await getProjects();
const index = projects.findIndex((entry) => entry.id === Astro.params.project);
const project = projects[index];
if (!project) return Astro.redirect("/404");

const { data } = project;
const file = `src/content/projects/${project.id}.md`;
const repo = await getRepo(data.repository);
const related = (await Promise.all(data.related.map((name) => getRepo(name)))).filter(
  (entry): entry is RepoEntry => entry !== undefined,
);
const isJexpanel = project.id === "jexpanel";
const isFalcon = project.id === "falcon-hosting";
const isTelcodash = project.id === "telcodash";
const { latest, lastYear } = releaseFacts(repo);

// The parts drawn on this page, whose numerals become live links in the description.
const parts: Sign[] = isJexpanel
  ? jexpanelSigns
  : isFalcon
    ? falconSigns("/jexpanel/")
    : isTelcodash
      ? telcodashSigns
      : [repo, ...related]
          .filter((entry): entry is RepoEntry => entry !== undefined)
          .map((entry, position) => ({ n: data.numeral + 2 * (position + 1), name: entry.fullName }));

const figures: string[] = isJexpanel
  ? [
      "is a block diagram of a Jexpanel deployment.",
      `charts the releases of ${repo?.fullName ?? "the repository"} above the commits by ${site.handle} in each month.`,
    ]
  : isFalcon
    ? ["is a block diagram of the service lines of Falcon Hosting, from its public site."]
    : isTelcodash
      ? ["is a block diagram of the Telcodash stack, showing how Core, the task gateway and the daemons communicate."]
      : repo
      ? [`shows the ${related.length ? "repositories" : "repository"} of ${data.title}, with ${related.length ? "their" : "its"} language composition.`]
      : [];

const body = project.rendered?.html;
const description = hasText(body) ? linkNumerals(body ?? "", parts) : null;
const hasMoreDrawings = figures.length > 1;
const sheets = 3 + (hasMoreDrawings ? 1 : 0);
const previous = projects[index - 1];
const next = projects[index + 1];
const shares = repo ? languageShares(repo.languages, 1) : [];
const references = [repo, ...related].filter((entry): entry is RepoEntry => entry !== undefined);
const isShortlist = data.kind === "shortlist";
const others = section(300);
const after = section(400);
---

<Document
  title={`${data.title}: specification, ${site.name}`}
  description={`${data.title}, from the portfolio of ${site.name} (${site.handle}).`}
  current={data.kind === "flagship" ? data.numeral : 300}
  sheets={sheets}
>
  <nav class="trail" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">{site.name}</a></li>
      {isShortlist && <li><a href={others.href}>{others.label}</a></li>}
      <li aria-current="page">{data.title}</li>
    </ol>
  </nav>

  <header class="title-block" id={`ref-${data.numeral}`} data-sheet data-ref={String(data.numeral)}>
    <div>
      <h1 style={`view-transition-name: title-${data.numeral}`}>
        {data.title}
      </h1>
      <p class="formerly">
        <span class="lining">({data.numeral})</span>
        {data.formerly ? ` Formerly ${data.formerly}. ` : " "}Specification from the portfolio of {site.name}.
      </p>
    </div>
    <Field label="Role" value={data.role} source={`${file} → role`} />
  </header>

  <div class="spec-front">
    <div class="spec-front__data">
      <dl class="furniture">
        <dt>Period</dt>
        <dd><Fill value={data.period} label={`Period on ${data.title}`} source={`${file} → period`} /></dd>
        {
          repo && (
            <>
              <dt>Repository</dt>
              <dd><a href={repo.url}><code>{repo.fullName}</code></a></dd>
            </>
          )
        }
        {
          data.website && (
            <>
              <dt>Website</dt>
              <dd><a href={data.website}>{new URL(data.website).host}</a></dd>
            </>
          )
        }
        {
          data.company && (
            <>
              <dt>Company</dt>
              <dd>{data.legalName}, No. {data.company.number}, registered in {data.company.registeredIn}</dd>
            </>
          )
        }
        {
          latest && repo && (
            <>
              <dt>Latest release</dt>
              <dd>
                <Live repo={repo.fullName} field="release" value={latest.tag} display={latest.tag} />, <Live repo={repo.fullName} field="releaseDate" value={latest.publishedAt} display={formatDate(latest.publishedAt)} /><span class="quiet">; {lastYear} releases in the past year</span>
              </dd>
            </>
          )
        }
        {
          repo?.contributor && (
            <>
              <dt>Standing</dt>
              <dd>
                <strong>{formatNumber(repo.contributor.contributions)} contributions</strong>, {formatNumber(commitsInLastYear(repo))} commits in the past year
              </dd>
            </>
          )
        }
        {
          repo && (
            <>
              {repo.stars + repo.forks > 0 && (
                <>
                  <dt>Reach</dt>
                  <dd>
                    <Live repo={repo.fullName} field="stars" value={repo.stars} display={formatNumber(repo.stars)} /> stars, <Live repo={repo.fullName} field="forks" value={repo.forks} display={formatNumber(repo.forks)} /> forks
                  </dd>
                </>
              )}
              <dt>Languages</dt>
              <dd>{shares.map((share) => `${share.name} ${percent(share.share)}`).join(", ") || repo.primaryLanguage}</dd>
              <dt>Created</dt>
              <dd>{formatDate(repo.createdAt)}<span class="quiet">; last push <Live repo={repo.fullName} field="pushed" value={repo.pushedAt} display={formatDate(repo.pushedAt)} /></span></dd>
            </>
          )
        }
        {
          data.stack.length > 0 && (
            <>
              <dt>Built with</dt>
              <dd>{data.stack.join(" · ")}</dd>
            </>
          )
        }
        {
          data.services.length > 0 && (
            <>
              <dt>Services</dt>
              <dd>{data.services.join("; ")}</dd>
            </>
          )
        }
        {
          data.regions.length > 0 && (
            <>
              <dt>Regions</dt>
              <dd>{data.regions.join(", ")}</dd>
            </>
          )
        }
      </dl>
    </div>

    <div class="spec-front__abstract">
      <h2 class="division">Abstract</h2>
      {data.summary ? <p>{data.summary}</p> : <Blank lines={4} label={`${data.title} abstract`} source={`${file} → summary`} />}
      <div style="margin-block-start: 2rem">
        {isJexpanel && <JexpanelDeployment fig={1} first />}
        {isFalcon && <FalconServices fig={1} jexpanelHref="/jexpanel/" jexpanelNote="Own specification" />}
        {isTelcodash && <TelcodashStack fig={1} first />}
        {!isJexpanel && !isFalcon && !isTelcodash && repo && (
          <RepositoryPlate fig={1} numeral={data.numeral} title={data.title} repos={[repo, ...related]} />
        )}
      </div>
    </div>
  </div>

  {
    figures.length > 0 && (
      <section class="division-block" aria-labelledby="drawings-list">
        <h2 class="division" id="drawings-list">Brief description of the drawings</h2>
        <ol class="figure-list">
          {figures.map((text, position) => (
            <li>
              <span class="smallcaps">FIG. {position + 1}</span> {text}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    hasMoreDrawings && repo && (
      <section class="division-block" data-sheet aria-labelledby="drawings">
        <h2 class="division" id="drawings">Drawings</h2>
        <div class="drawings">
          <ReleaseActivity fig={2} repo={repo} user={site.handle} sheet={`Sheet 2 of ${sheets}`} />
        </div>
      </section>
    )
  }

  <section class="division-block" data-sheet aria-labelledby="description">
    <h2 class="division" id="description">Detailed description</h2>
    {
      description ? (
        <div class="description" set:html={description} />
      ) : (
        <div class="description" data-source={import.meta.env.DEV ? `${file} → body` : undefined}>
          <Blank lines={4} label={`${data.title}, paragraph 1`} />
          <Blank lines={4} label={`${data.title}, paragraph 2`} />
          <Blank lines={3} label={`${data.title}, paragraph 3`} />
        </div>
      )
    }
  </section>

  <section class="division-block" data-sheet aria-labelledby="references">
    <h2 class="division" id="references">References cited</h2>
    <ol class="references">
      {
        references.map((entry) => (
          <li>
            <span>
              <a href={entry.url}><code>{entry.fullName}</code></a>
              <span class="cite-meta">
                {entry.description && <q>{entry.description}</q>}
                {entry.description && " "}
                {[
                  entry.primaryLanguage,
                  entry.stars > 0 ? `${formatNumber(entry.stars)} ${entry.stars === 1 ? "star" : "stars"}` : null,
                  entry.license,
                  `created ${formatDate(entry.createdAt)}`,
                  entry.archived ? "archived" : null,
                ]
                  .filter(Boolean)
                  .join(" · ")}
                {entry.homepage && (
                  <>
                    {" · "}
                    <a href={entry.homepage}>{new URL(entry.homepage).host}</a>
                  </>
                )}
              </span>
            </span>
          </li>
        ))
      }
      {
        data.website && (
          <li>
            <span>
              <a href={data.website}>{new URL(data.website).host}</a>
              <span class="cite-meta">Website of {data.legalName ?? data.title}</span>
            </span>
          </li>
        )
      }
    </ol>
  </section>

  <nav class="pager" aria-label="More projects">
    {
      previous ? (
        <a href={`/${previous.id}/`} rel="prev">
          <span class="dir"><span aria-hidden="true">← </span>Previous project</span>
          <span class="title">{previous.data.title}</span>
        </a>
      ) : (
        <a href="/">
          <span class="dir"><span aria-hidden="true">← </span>Front page</span>
          <span class="title">{site.name}</span>
        </a>
      )
    }
    {
      next ? (
        <a href={`/${next.id}/`} rel="next">
          <span class="dir">Next project<span aria-hidden="true"> →</span></span>
          <span class="title">{next.data.title}</span>
        </a>
      ) : (
        <a href={after.href}>
          <span class="dir">Back to the front page<span aria-hidden="true"> →</span></span>
          <span class="title">{after.label}</span>
        </a>
      )
    }
  </nav>
</Document>
